          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"realmd\",container!=\"\",container!=\"POD\"} and on(pod) (kube_pod_status_phase{namespace=\"realmd\",phase=\"Running\"} == 1))",
          "legendFormat": "{{pod}}"
        }
      ]
