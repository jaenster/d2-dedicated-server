        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (game) (count_over_time({namespace=\"realmd\", app=\"d2gs\"} | json evt=\"evt\", game=\"game\", players=\"players\", gsid=\"gsid\" | evt=`tick` [5m])))",
          "queryType": "instant"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 10
