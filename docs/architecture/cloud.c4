// Kubernetes deployment topology for the cloud-native d2gs realm.
//
// Maps the logical model (diablo2.c4) onto k8s objects: a stateless realmd
// front behind a LoadBalancer, Redis (ephemeral) + Postgres (durable), the
// qqserver game-traffic gateway behind its own LoadBalancer, and a GS
// StatefulSet of INTERNAL (ClusterIP) pods. The player logs in via the realmd
// LB, then talks game traffic to the qqserver LB, which splices each connection
// (routed by source IP) through to the owning GS pod.
//
// View it with:  npx likec4 start docs/architecture

deployment {

  // External player — its own deployment node (the internet side of the LB).
  service lb_player 'Player' {
    description 'Unmodified D2 client on the internet'
  }

  cluster prod 'Kubernetes cluster' {

    // realmd front: stateless, /readyz-gated, fronted by a LoadBalancer Service.
    service realmd_lb 'realmd Service (LoadBalancer)' {
      description 'Exposes :6112-6115; routes to ready realmd pods only'
    }
    workload realmd_deploy 'realmd Deployment' {
      description '2 replicas, stateless front, /readyz gated, SIGTERM drain'
      instanceOf d2gs.realmd.bncs
      instanceOf d2gs.realmd.rd2cs
      instanceOf d2gs.realmd.gslink
      instanceOf d2gs.realmd.health
    }

    // qqserver game-traffic gateway: its own LoadBalancer + Deployment. The single
    // public :4000; splices each connection (routed by source IP) to a GS pod.
    service qqserver_lb 'qqserver Service (LoadBalancer)' {
      description 'The one public :4000 for game traffic'
    }
    workload qqserver_deploy 'qqserver Deployment' {
      description '1..N stateless gateway pods; route by source IP, splice to the GS'
      instanceOf d2gs.qqserver
    }

    // Backing stores.
    service redis_svc 'Redis Service' {
      description 'Ephemeral sessions + games + route map (native TTL)'
      instanceOf d2gs.realmd.store_redis
    }
    service pg_svc 'Postgres Service' {
      description 'Durable character saves'
      instanceOf d2gs.realmd.store_pg
    }

    // GS fleet as a StatefulSet — INTERNAL pods (ClusterIP); reached only by the
    // qqserver. No public/hostPort exposure needed anymore.
    workload gs_set 'GS StatefulSet' {
      description 'Stable per-pod identity; internal ClusterIP :4000 (reached via the qqserver)'

      pod gs_pod_a 'gs-0 pod' {
        description 'Internal :4000; registers out to realmd over gslink (ADDRINFO = its cluster IP)'
        instanceOf d2gs.gameserver
      }
      pod gs_pod_b 'gs-1 pod' {
        description 'Internal :4000; registers out to realmd over gslink (ADDRINFO = its cluster IP)'
        instanceOf d2gs.gameserver
      }
    }
  }

  // Player login goes through the LoadBalancer to realmd.
  lb_player -> realmd_lb 'login/realm (:6112-6115)'
  realmd_lb -> realmd_deploy 'to ready pods'

  // realmd -> backing stores (writes the route map into redis on JOINGAME).
  realmd_deploy -> redis_svc 'ephemeral (sessions+games+routes)'
  realmd_deploy -> pg_svc 'durable (chars)'

  // GS pods register OUT to realmd's gslink (:6115); realmd routes create/join.
  gs_pod_a -> realmd_deploy 'gslink register (:6115) + ADDRINFO (cluster IP)'
  gs_pod_b -> realmd_deploy 'gslink register (:6115) + ADDRINFO (cluster IP)'

  // The player talks game traffic to the qqserver LB; the gateway looks up the
  // route by source IP and splices to the owning internal GS pod.
  lb_player -> qqserver_lb 'game traffic (:4000)'
  qqserver_lb -> qqserver_deploy 'to gateway pods'
  qqserver_deploy -> redis_svc 'lookup route by source IP'
  qqserver_deploy -> gs_pod_a 'splice to owning GS (internal :4000)'
  qqserver_deploy -> gs_pod_b 'splice to owning GS (internal :4000)'
}

views {

  // The full k8s topology: LB front, stores, GS StatefulSet, direct game path.
  deployment view k8s_deploy {
    title 'Kubernetes deployment topology'
    include *
    autoLayout TopBottom
  }
}
