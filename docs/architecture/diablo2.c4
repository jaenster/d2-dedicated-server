// Diablo II 1.14d architecture — the native game (reverse-engineered module graph)
// plus the d2gs project's own parts (injected DLL + clean-room realm backend).
//
// View it with:  npx likec4 start docs/architecture
// (or the LikeC4 VS Code extension)

specification {

  element domain {
    style {
      color muted
      opacity 10%
    }
  }

  // A statically-linked module that was originally a separate DLL pre-1.14d.
  element module {
    style {
      shape rectangle
    }
  }

  // One of our own components (Zig).
  element component {
    style {
      shape rectangle
      color green
    }
  }

  // A separate process / binary.
  element process {
    style {
      shape rectangle
      color blue
    }
  }

  element actor {
    style {
      shape person
    }
  }

  element store {
    style {
      shape cylinder
      color green
    }
  }

  tag native
  tag ours
  tag foundation

  // Deployment topology (k8s) — used by cloud.c4.
  deploymentNode cluster {
    style {
      opacity 10%
    }
  }
  deploymentNode service {
    style {
      shape rectangle
      color blue
    }
  }
  deploymentNode workload {
    style {
      shape rectangle
      color green
    }
  }
  deploymentNode pod {
    style {
      shape rectangle
    }
  }
}

model {

  player = actor 'Player' {
    description 'Runs a normal D2 client and joins a hosted game'
  }

  // ---------------------------------------------------------------------------
  // The native Diablo II domain — the modules inside 1.14d Game.exe.
  // In 1.14d these are statically linked into one binary; pre-1.14 they were
  // the D2*.dll / Storm.dll / Fog.dll files. Edges = real call/data deps.
  // ---------------------------------------------------------------------------
  diablo2 = domain 'Diablo II (native, 1.14d Game.exe)' {

    gameexe = module 'Game.exe entry' {
      #native
      description 'Process entry / glue that wires up the client and game subsystems'
    }

    // -- gameplay / top layer --
    d2client = module 'D2Client' {
      #native
      description 'Client-side: input, HUD/UI orchestration, rendering, local sim'
    }
    d2game = module 'D2Game' {
      #native
      description 'Server-side game logic: world, AI, quests, drops (what d2gs drives)'
    }

    // -- shared mid layer --
    d2common = module 'D2Common' {
      #native
      description 'Shared game data + logic: units, items, skills, inventory, DRLG, DataTbls. The base everything builds on.'
    }

    // -- subsystems --
    d2win = module 'D2Win' {
      #native
      description 'UI widgets / windowing'
    }
    d2net = module 'D2Net' {
      #native
      description 'Game network layer'
    }
    d2sound = module 'D2Sound' {
      #native
      description 'Audio'
    }
    d2cmp = module 'D2CMP' {
      #native
      description 'Cel / sprite (DC6) compression'
    }
    d2lang = module 'D2Lang' {
      #native
      description 'String tables / localization'
    }
    d2opengl = module 'D2OpenGL' {
      #native
      description 'OpenGL render backend (mac path)'
    }

    // -- foundation --
    fog = module 'Fog' {
      #native
      #foundation
      description 'OS abstraction: memory pools, async, registry, file'
    }
    storm = module 'Storm' {
      #native
      #foundation
      description 'Blizzard base lib: MPQ archives, networking, memory'
    }

    // native dependency edges (top -> bottom)
    gameexe -> d2client 'hosts client'
    gameexe -> d2game 'hosts game server'

    d2client -> d2common 'game data/logic'
    d2client -> d2win 'UI'
    d2client -> d2net 'netplay'
    d2client -> d2sound 'audio'
    d2client -> d2cmp 'sprites'
    d2client -> d2lang 'strings'
    d2client -> d2opengl 'render'

    d2game -> d2common 'game data/logic'
    d2game -> d2net 'netplay'

    d2win -> d2lang 'strings'
    d2win -> d2cmp 'sprites'

    d2common -> fog 'memory/file'
    d2common -> storm 'archives'
    d2net -> storm 'sockets'
    d2sound -> fog
    d2cmp -> fog
    d2opengl -> fog

    fog -> storm 'base services'
  }

  // CheckRevision.dll — separate native module, used for the version gate.
  checkrevision = module 'CheckRevision.dll' {
    #native
    description '1.14d version-check DLL (CheckRevision export)'
  }

  // ---------------------------------------------------------------------------
  // The d2gs domain — our code. A headless dedicated-server driver injected into
  // Game.exe, plus a clean-room realm backend (pvpgn replacement).
  // ---------------------------------------------------------------------------
  d2gs = domain 'd2gs (our project)' {

    dbghelp = component 'dbghelp.dll proxy' {
      #ours
      description 'DLL-search-order proxy loaded by Game.exe; LoadLibrary-injects d2gs.dll'
    }

    dll = component 'd2gs.dll' {
      #ours
      description 'Injected payload: boots Game.exe as a headless dedicated server'

      runtime = component 'runtime (plumbing + drivers)' {
        #ours
        description 'Low-level in-process machinery: patch.zig (MemoryPatch fluent byte-patcher), fastcall.zig + trampoline.zig (x86 __fastcall shims / detours), plus the fan-out DRIVERS that own an engine byte-hook and dispatch to features: gameloop (frame), drawing (automap draw), roominit (per-game RoomInit), pkttrace (packets). gsport/joindiag/realmgw helpers.'
      }
      engine = component 'engine' {
        #ours
        description 'server.zig boots QServer; realm.zig wires GS realm callbacks (fpGetDatabaseCharacter); command.zig'
      }
      realmclient = component 'realm client' {
        #ours
        description 'In-process redis client: publishes the server record, blocks on its own queue for CREATE/JOIN, answers on the reply key, pushes enter/leave/closed events, and reads/writes characters directly. No socket to realmd — the d2cs and d2dbs clients are gone.'
      }

      // -- the Charon-style feature framework (engine/feature.zig) --
      framework = component 'feature framework' {
        #ours
        description 'engine/feature.zig — Charon-style registry: comptime @hasDecl dispatch over a single central config table, runtime-toggleable per feature (flags now, realm/redis later), per-game GameCtx backed by the game own FOG pool. A feature is a pure module declaring pub fn hooks; drivers in runtime/ fan out to it.'
      }
      survival = component 'survival/diag features' {
        #ours
        description 'runtime/feature/*: headless (renderer/media stubs), crash, halt_hook, gamecrashfix, multiinstance, checkrev_patch, nocompress, clientdiag, srvdiag.'
      }
      maphack = component 'maphack (client features)' {
        #ours
        description 'runtime/feature/: omnivision (see through walls + full-bright), mapreveal (auto-reveal automap), mapunits (monster/item/missile dots). Ported from aether. Client-side — d2gs.dll injects into the real client too (--d2gs without --d2gs-boot).'
      }
      servermods = component 'server game mods' {
        #ours
        description 'runtime/feature/: expmod (exp scaling — wraps CALC_Experience, drives fanExpAward), ubers (Pandemonium / Uber Tristram: roomInit spawns, cube portals, KillMonster torch drop, boss-AI summon adds; no Diablo Clone). Ported from Charon.'
      }
      d2layer = component 'engine bindings + structs' {
        #ours
        description 'engine/d2types.zig + engine/d2/{types,functions,globals,automap}.zig — D2 1.14d structs mirrored from the Ghidra recon (offsets comptime-asserted) + the fastcall(addr,FnType).call(.{}) engine-call generator (vendored from aether). fog.zig wraps D2 FOG memory pools as a std.mem.Allocator (per-game lifetime + cleanup).'
      }

      // framework dispatches to features; features use the d2 bindings/structs.
      framework -> survival 'dispatches install/lifecycle'
      framework -> maphack 'dispatches draw/frame hooks'
      framework -> servermods 'dispatches server + roomInit/expAward hooks'
      runtime -> framework 'drivers fan out to features'
      maphack -> d2layer 'structs + engine draw calls'
      servermods -> d2layer 'structs + engine spawn/exp calls'
      d2layer -> runtime 'byte-patch + fastcall shims'
    }

    realmd = process 'realmd' {
      #ours
      description 'Clean-room Zig pvpgn replacement — one binary, multi-instance. Binds exactly two ports: 6112 (BNCS login + MCP realm, muxed the way real Battle.net does it) and 8080 (health/admin). The old 6113 (standalone d2cs), 6114 (d2dbs) and 6115 (game-server control link) listeners are gone — everything they carried travels through redis.'

      bncs = component 'bncs (bnetd)' {
        #ours
        description 'apps/realmd/bncs.zig — Battle.net login, account/profile, and the chat protocol on :6112'
      }
      chat = component 'chat' {
        #ours
        description 'apps/realmd/chat.zig — channels across instances. A member is held by whichever instance owns its socket, so local delivery still goes straight down that socket; members are also published into a shared per-channel roster plus a by-name index, and talk, whispers and the user list reach members held elsewhere via that instance\'s inbox (realmd:chatin:<instance>). Getting this wrong fails silently: talk vanishes and a whisper claims a logged-on user is not there.'
      }
      bnftp = component 'bnftp' {
        #ours
        description 'BNFTP file transfer for the version check. The ONLY thing the realm reads from local disk (packages/realm-store/assets.zig): read-only image content — the version-check MPQ (ver-IX86-1.mpq) and the banner ad — identical on every instance, so there is nothing to keep in sync. On k8s <data_dir>/bnftp is populated by a load-vermpq initContainer; the game-data set carries no ver-IX86-1.mpq, so that file comes from wherever the deployment sources it.'
      }
      rd2cs = component 'd2cs' {
        #ours
        description 'Realm (MCP, muxed onto :6112): char select, game create/join sessions'
      }
      charflush = component 'charflush' {
        #ours
        description 'Moves saved characters from the redis cache to Postgres. Every instance runs one; they need no coordination because a flush reads the current bytes and only clears the dirty flag if the save version has not moved.'
      }
      fleet = component 'fleet' {
        #ours
        description 'apps/realmd/fleet.zig — the game servers as the whole realm sees them, through redis, with nothing connecting the two: pick-and-reserve the least loaded with room (one EVAL, so two instances cannot choose the same slot), dispatch CREATE/JOIN to that server\'s queue (realmd:gsq:<gsid>) and collect the reply by its packet seq (realmd:gsreply:<seq>), and drain the shared event list (realmd:gsev) servers report enter/leave/closed on.'
      }

      // 12-factor app surface for k8s.
      health = component 'health' {
        #ours
        description 'HTTP :8080 — /healthz liveness, /readyz readiness (store reachability + a game server published in the store + draining); also the admin API and web UI'
      }
      shutdown = component 'shutdown' {
        #ours
        description 'SIGTERM -> drain -> exit (graceful k8s termination)'
      }

      // Persistence facade (DDD, no adapters): apps/realmd/store.zig names the operations in D2
      // terms and each one has exactly one home. There is no backend selection any more — the
      // filesystem backend is deleted, and both Postgres and redis are required.
      db = store 'store facade' {
        #ours
        description 'apps/realmd/store.zig — domain ops (getCharD2s/saveCharD2s, mintSession/accountForSession, registerGame/findGame, the chat roster, the fleet + its queues). No backend choice: each op has one home. Postgres is the store of record, redis is everything in flight, and realmd refuses to start without either.'
      }
      store_redis = store 'redis' {
        #ours
        description 'Everything in flight, and the realm\'s centre: sessions, games, seats, tokens, the d2ingress routes, the chat rosters + per-instance inboxes, the fleet and its queue/reply/event keys — plus the LIVE character, cached in front of Postgres so a save is acknowledged without waiting on it. Must run noeviction: it holds the only copy of a dirty save.'
      }
      store_pg = store 'postgres' {
        #ours
        description 'The store of record: characters, accounts, profiles, guilds. Shared by every instance — "the file on this pod" was a different answer per pod, which is what killed the filesystem backend.'
      }

      rd2cs -> db 'sessions / games'
      fleet -> db 'fleet, queues, events'
      chat -> db 'roster + by-name index + per-instance inbox'
      charflush -> db 'redis -> postgres'
      db -> store_redis 'in flight + the live character'
      db -> store_pg 'store of record'
      bnftp -> db 'BNFTP assets (the only disk read)'
      health -> db 'readiness probe'
      health -> fleet 'is any game server published'
      shutdown -> fleet 'drain games'
      fleet -> rd2cs 'announces games'
      bncs -> chat 'channel join / talk / whisper'
    }

    // The headless game-server fleet. Nothing connects it to realmd: each publishes itself
    // into redis and takes its work from a queue there.
    gameserver = process 'd2gs game server (fleet, 1..N)' {
      #ours
      description 'Headless Game.exe + d2gs.dll under wine+Xvfb. Publishes its own record into redis (<ip>:4000, gsid, capacity, load, full) and refreshes it on its tick; takes CREATE/JOIN from its own queue; reports players entering/leaving and games ending as events. Serves game traffic on :4000. On k8s it is INTERNAL (publishes status.podIP:4000, no hostPort) with an in-process health endpoint on :8086.'
    }

    // d2ingress — a SEPARATE binary (apps/d2ingress/main.zig): the cloud-native
    // game-traffic gateway. A QServer-of-QServers — one public :4000 that splices each
    // client connection through to the owning GS, so GS pods stay internal.
    d2ingress = process 'd2ingress (game gateway)' {
      #ours
      description 'Stateless token-translation TCP proxy ("QServer-of-QServers"). One public :4000; reads the u16 token from the client GAMELOGON (0x68), looks up token -> (GS, real gameid) in the shared map realmd writes, rewrites the token to the GS gameid, and splices to the GS internal :4000. Token is realm-globally-unique (shared counter), so any front pod behind any LB IP resolves any token: fully stateless, no affinity. Write-once infra.'
    }
  }

  // ---- how our parts attach to the native game ----
  dbghelp -> dll 'LoadLibrary injects'
  runtime -> gameexe 'patches/hooks the live process'
  runtime -> checkrevision 'patches version gate'
  engine -> d2game 'boots QServer + drives the tick loop'
  engine -> d2common 'reads game/character data'
  engine -> realmclient 'GS realm callbacks'

  // feature framework: client maphack hooks the renderer, server mods hook game
  // logic, and the d2 layer allocates from the engine FOG pools.
  maphack -> d2client 'hooks automap / line-of-sight rendering (client-side)'
  servermods -> d2game 'hooks exp / kill / boss-AI / item+monster spawn logic'
  d2layer -> fog 'allocates from FOG memory pools (per-game lifetime)'

  // ---- realm wiring: through the store, never point to point ----
  realmclient -> db 'publishes itself; takes CREATE/JOIN from its queue; reads/writes characters'
  fleet -> db 'picks + reserves a server, pushes the request, collects the reply by seq'
  db -> fleet 'the events servers report: player enter/leave, game closed'
  fleet -> dll 'drives game lifecycle'
  dll -> gameserver 'is one fleet member'

  // ---- d2ingress: the game-traffic gateway (separate binary) ----
  rd2cs -> db 'mints a unique token (shared counter); records token -> (GS, real gameid)'
  d2ingress -> db 'looks up token -> (GS, real gameid)'
  d2ingress -> gameserver 'rewrites token to the GS gameid; splices (internal :4000)'

  // ---- the player join flow ----
  player -> d2client 'plays via a normal D2 client'
  d2client -> bncs 'BNCS login'
  d2client -> bnftp 'version/MPQ gate'
  d2client -> rd2cs 'pick realm / join game'
  d2client -> d2ingress 'game traffic (:4000, D2Net) — gateway splices to the GS'
}

views {

  view index {
    title 'Landscape — native D2 + d2gs'
    include *
    autoLayout TopBottom
  }

  // The question that started this: how the native modules layer.
  view native of diablo2 {
    title 'Diablo II native module dependencies'
    include *
    autoLayout TopBottom
  }

  // Our parts and how they hook into the native game + each other.
  view d2gs_overview of d2gs {
    title 'd2gs — injected server driver + realm backend'
    include *
    include diablo2, gameexe, d2game, d2common, checkrevision
    autoLayout LeftRight
  }

  // The Charon-style feature framework inside d2gs.dll: the registry dispatches to
  // pure feature modules (survival, client maphack, server mods); runtime drivers own
  // the engine byte-hooks and fan out; the d2 layer supplies structs/engine calls and
  // the per-game FOG allocator. Shows how each set attaches to the native game.
  view feature_framework {
    title 'd2gs.dll — feature framework'
    include dll, framework, runtime, survival, maphack, servermods, d2layer, engine
    include d2client, d2game, d2common, fog
    autoLayout LeftRight
  }

  // End-to-end: a player getting into a hosted game. Login at realmd, then ALL game
  // traffic goes to the d2ingress — the only game endpoint the client ever sees — which
  // translates the token and splices through to the real GS behind it.
  view join_flow {
    title 'Player join flow'
    include player, d2client, bncs, chat, bnftp, rd2cs, fleet, d2ingress, gameserver, dll, engine, d2game, db
    autoLayout LeftRight
  }

  // The GS fleet: servers publish themselves into redis and realmd dispatches through it —
  // CREATE to the least-loaded with room, JOIN to the server that owns the game.
  view gs_fleet {
    title 'GS fleet — published in redis, dispatched through it'
    include player, d2client, rd2cs, fleet, charflush, gameserver, dll, realmclient, db, store_redis, store_pg, health, shutdown
    autoLayout LeftRight
  }
}
