.{
    .name = .d2gs,
    // The project's own version, which is what a consumer of this manifest reads — not the Zig
    // version it happens to be built with. Kept in step with the release tags.
    .version = "0.2.0",
    .dependencies = .{
        .pg = .{
            .url = "git+https://github.com/karlseguin/pg.zig#4215baf19f7f61a94aab9f6c5893ea12aa9bce96",
            .hash = "pg-0.0.0-Wp_7gYr_BgC1O2IRXa8tdwXhOZJLLSAl7F_ut1N07zF7",
            .lazy = true,
        },
        // The clean-room 1.14d core. d2gs consumes libd2 rather than carrying its own copy
        // of anything libd2 already models — the .d2s header helpers here were a duplicate
        // of d2-formats down to the byte offsets.
        //
        // Pinned by URL, not to a sibling checkout. The images are built from this repo alone —
        // the Dockerfile copies build.zig, build.zig.zon, apps/ and packages/ and nothing else —
        // so a `../libd2` path dependency resolved on a developer's machine and nowhere else, and
        // every image build since the path landed failed on it. A pin also makes the version a
        // deliberate commit here rather than whatever happens to be checked out next door.
        .libd2 = .{
            .url = "git+https://github.com/jaenster/libd2?ref=v0.6.2#a053e4c7730e56b6394ea11f1758c3d925c55e10",
            .hash = "libd2-0.6.2-wboU7SHEogEpJA80W-hJEq9SdHdSDHMFu5AHl03ZNlV8",
        },
    },
    .paths = .{""},
    .fingerprint = 0x515f5350c25b80ed,
}
