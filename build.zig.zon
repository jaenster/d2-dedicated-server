.{
    .name = .d2gs,
    // The project's own version, which is what a consumer of this manifest reads — not the Zig
    // version it happens to be built with. Kept in step with the release tags.
    .version = "0.3.0",
    .dependencies = .{
        .pg = .{
            .url = "git+https://github.com/karlseguin/pg.zig#0ccd7d9dabce32e4cee0dd789d8007934099a0f9",
            .hash = "pg-0.0.0-Wp_7geJVBwDaf2o8erlmelEP5RBEuMESnFWWrNLQneEy",
            .lazy = true,
        },
        // The clean-room 1.14d core. d2gs consumes libd2 rather than carrying its own copy
        // of anything libd2 already models — the .d2s header helpers here were a duplicate
        // of d2-formats down to the byte offsets.
        //
        // Pinned by URL, not to a sibling checkout. The images are built from this repo alone —
        // the Dockerfile copies build.zig, build.zig.zon, apps/ and packages/ and nothing else —
        // so a `../libd2` path dependency resolved on a developer's machine and nowhere else, and
        // every image build since the path landed failed on it. A pin also makes the version a
        // deliberate commit here rather than whatever happens to be checked out next door.
        .libd2 = .{
            .url = "git+https://github.com/jaenster/libd2?ref=v0.7.0#89db01dffcead00f860e46a5d3497e85e65ac666",
            .hash = "libd2-0.7.0-wboU7Y-H6QF2nXTOzWxeSGI4t0-_zQUxrdSAldJacpiw",
        },
        // The real GS-join + world-decode leg, for tools/stress-e2e: d2-realm and d2-session are
        // published from there specifically so a second Zig program can drive real games without
        // re-implementing BNCS/MCP/GS session handling a third time (tools/e2e/realmclient.zig is
        // already a second, from-scratch implementation of the realm half of this). Lazy because
        // nothing else here needs it — a plain `zig build` for the deploy images shouldn't fetch it.
        .clientless = .{
            .url = "git+https://github.com/jaenster/d2-clientless#1d890a7bc68afc73d7e8a0b76f8a80fe2de61ec7",
            .hash = "clientless-0.1.0-lyHu8uXOAwDzZid4iuK7U4UNdyieUej2nUZK2dIKCzBg",
            .lazy = true,
        },
    },
    .paths = .{""},
    .fingerprint = 0x515f5350c25b80ed,
}
