# vermpq: the tool source IS tracked, but never the signing key/cert (it
# impersonates "Blizzard Entertainment, Inc." — generate your own with
# gen-cert.sh) or the build artifacts.
tools/vermpq/blizz.key
tools/vermpq/blizz.crt
tools/vermpq/blizz.p12
tools/vermpq/*.signed.dll
tools/vermpq/ver-IX86-1.dll
tools/vermpq/*.mpq
tools/vermpq/make_vermpq
114clean
clientgame/

# macOS
.DS_Store

# bnftp-probe captured files (Blizzard MPQs etc — do not commit)
bnftp-*.mpq
bnftp-*.bin

# realmd runtime data (may contain Blizzard MPQs — do not commit)
/realmd-data/

# revar variable-naming campaign scratch (per-session worklists, not source)
.revar-pass2/

# compiled standalone tools (built manually, not via build.zig)
tools/mpqcat/mpqcat
tools/mpqmin/mpqmin

# arena-mode design/worklist — local planning doc, not in VCS
ARENA.md

# clientless-join.mjs harness work dir
.clientless/
probegame/

# run-stack.sh runtime logs
.stack/

# local launchers: they hardcode this machine's wine prefixes and install dirs
/run.sh
/run-*.sh

# a data dir named "=<port>" means something leaked an env assignment into a path
/=*
testgame-min-mac/
