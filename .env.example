# Copy to .env and set for your machine (.env is gitignored).

# A ready D2 1.14d install to hardlink from — must contain d2data.mpq, Game.exe, etc.
D2GS_GAME_SRC=/path/to/your/d2/install

# A dbghelp.dll proxy that forwards real dbghelp exports and LoadLibrary's the
# DLLs passed via `-loaddll <winpath>` on the command line.
D2GS_DBGHELP=/path/to/dbghelp.dll

# Optional:
# D2GS_TESTDIR=./testgame
# WINE=wine
